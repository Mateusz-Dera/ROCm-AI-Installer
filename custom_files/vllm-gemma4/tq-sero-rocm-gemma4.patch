+def _seg_unnormalized(q_g, k_g, v_g, scale, mask=None):
+    """Unnormalized attention over one K/V segment.
+
+    Returns (out, m, l) so segments can be merged with the standard online
+    softmax rescaling instead of concatenating every key first.
+    """
+    scores = torch.bmm(q_g, k_g.transpose(1, 2))
+    scores.mul_(scale)                       # was: * scale (extra full-size temp)
+    if mask is not None:
+        scores.masked_fill_(mask, float("-inf"))
+    m = scores.max(dim=-1, keepdim=True).values
+    m = torch.where(torch.isneginf(m), torch.zeros_like(m), m)
+    # scores becomes p in place: subtracting the running max and exponentiating
+    # elementwise needs no second buffer, and holding scores, (scores - m) and p
+    # at once tripled the peak for no benefit.
+    scores.sub_(m).exp_()
+    # The sum and the merged output stay fp32 even when the segment is computed
+    # in fp16: they are one value per query row, so the precision is free, and
+    # summing thousands of terms is where fp16 would actually drift.
+    out = torch.bmm(scores, v_g)
+    return (out.float(), m.float(),
+            scores.sum(dim=-1, keepdim=True, dtype=torch.float32))
+
+
+def _merge_segments(a, b):
+    """Combine two unnormalized (out, m, l) triples."""
+    o1, m1, l1 = a
+    o2, m2, l2 = b
+    m = torch.maximum(m1, m2)
+    a1 = torch.exp(m1 - m)
+    a2 = torch.exp(m2 - m)
+    return o1 * a1 + o2 * a2, m, l1 * a1 + l2 * a2
+

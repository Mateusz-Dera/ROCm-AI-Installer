+def _slice_value_q(vq, start: int, end: int):
+    """Token-dim slice of a flattened ValueQuantized (H, T, ...)."""
+    from turboquant.kv_cache import ValueQuantized
+
+    return ValueQuantized(
+        data=vq.data[:, start:end],
+        scales=vq.scales[:, start:end],
+        zeros=vq.zeros[:, start:end],
+        bits=vq.bits,
+    )

+def _num_requests(attn_metadata) -> int:
+    """How many requests the batch really holds.
+
+    num_reqs is not reliable here - it has been observed reporting 1 for a
+    two-request batch, which silently truncated the batch to the first request
+    and returned half the expected rows. query_start_loc has one entry per
+    request plus a terminator, and it is the same array the spans are cut
+    from, so deriving the count from it cannot disagree with them.
+    """
+    qsl = getattr(attn_metadata, "query_start_loc_cpu", None)
+    if qsl is None:
+        qsl = getattr(attn_metadata, "query_start_loc", None)
+    if qsl is not None:
+        n = (len(qsl) if hasattr(qsl, "__len__") else int(qsl.shape[0])) - 1
+        if n >= 1:
+            return n
+    return int(getattr(attn_metadata, "num_reqs", 1) or 1)
+
+
+def _req_span(attn_metadata, r: int, num_actual: int):
+    """Token range [start, end) of request r within the flattened batch."""
+    qsl = getattr(attn_metadata, "query_start_loc_cpu", None)
+    if qsl is None:
+        qsl = getattr(attn_metadata, "query_start_loc", None)
+    if qsl is None:
+        return 0, num_actual
+    v = qsl.tolist() if hasattr(qsl, "tolist") else list(qsl)
+    if r + 1 >= len(v):
+        return 0, num_actual
+    return int(v[r]), int(v[r + 1])
 
 

+def _fused_block(share, vq, group_size, start_pos):
+    """(k, v) for one history block, both [H, N, D], via the fused kernel."""
+    from turboquant.fused import dequant_norm_rope
+
+    k_norm, rot = share
+    eps = getattr(k_norm, "variance_epsilon", getattr(k_norm, "eps", 1e-6))
+    return dequant_norm_rope(
+        vq, k_norm.weight, rot.cos_sin_cache, start_pos,
+        group_size=group_size, eps=eps,
+    )
+

+def _new_store_engine(cfg: LayerConfig, template=None):
+    """Build a (store, engine) pair matching `template`'s configuration.
+
+    share_kv lives on the store instance rather than in LayerConfig, so it has
+    to be copied explicitly or later sessions silently run a different code
+    path from the first one.
+    """
+    store = CompressedKVStore(
+        head_dim=cfg.head_dim,
+        num_kv_heads=cfg.num_kv_heads,
+        key_bits=cfg.key_bits,
+        value_bits=cfg.value_bits,
+        value_group_size=cfg.value_group_size,
+        device=cfg.device,
+        layer_idx=cfg.layer_idx,
+    )
+    if template is not None:
+        store.share_kv = getattr(template, "share_kv", False)
+    engine = KVCaptureEngine(
+        store=store,
+        ring_capacity=cfg.ring_capacity,
+        device=cfg.device,
+    )
+    return store, engine
+

+        y = y.reshape(-1, d)
+        h *= 2
+    return y.reshape(orig)
+
+
+def generate_sign_vector(d: int, device: torch.device, seed: int = 42
+                         ) -> torch.Tensor:
+    """Random +/-1 diagonal for the randomized Hadamard transform."""
+    rng = torch.Generator(device="cpu")
+    rng.manual_seed(seed)
+    signs = (torch.randint(0, 2, (d,), generator=rng, dtype=torch.int8) * 2 - 1)
+    return signs.to(device=device, dtype=torch.float32)
+
+
+def rotate_forward_fast(x: torch.Tensor, signs: torch.Tensor) -> torch.Tensor:
+    """y = H(Dx)/sqrt(d) - orthogonal, and its own inverse up to the sign flip."""
+    d = x.shape[-1]
+    return _fwht(x * signs) / math.sqrt(d)
+
+
+def rotate_backward_fast(y: torch.Tensor, signs: torch.Tensor) -> torch.Tensor:
+    """x = D(Hy)/sqrt(d). H is symmetric with H^2 = d*I and D^2 = I."""
+    d = y.shape[-1]
+    return _fwht(y) / math.sqrt(d) * signs
+
+# ─────────────────────────────────────────────────────────────────────────────
+#  Block-diagonal rotor rotation (RotorQuant-style)
+# ─────────────────────────────────────────────────────────────────────────────
+
+_ROTOR_BLOCK = 4          # SO(4) blocks, as in the quaternion/isoclinic variants
+
+
+def _rounds_for(d: int) -> int:
+    """How many block+shuffle rounds until every coordinate can reach every
+    other one. Each round mixes within a block of 4, so reach grows 4x."""
+    r, reach = 0, 1
+    while reach < d:
+        reach *= _ROTOR_BLOCK
+        r += 1
+    return max(1, r)
+
+
+def generate_rotor_params(d: int, device: torch.device, seed: int = 42):
+    """Random SO(4) blocks per round, plus the stride permutation.
+
+    Each block is drawn as a QR of a 4x4 Gaussian and forced to determinant +1
+    so it is a rotation rather than a reflection - the distinction the rotor
+    formulation cares about.
+    """
+    assert d % _ROTOR_BLOCK == 0, f"head_dim {d} must be divisible by 4"
+    rng = torch.Generator(device="cpu")
+    rng.manual_seed(seed)
+
+    n_rounds = _rounds_for(d)
+    n_blocks = d // _ROTOR_BLOCK
+
+    # Build each SO(4) block as a product of Givens rotations, one per pair of
+    # axes. Six planes span SO(4), every factor is a rotation so the determinant
+    # is +1 by construction, and no decomposition is needed - this torch build
+    # has no CPU LAPACK, so torch.linalg.qr is unavailable here.
+    planes = [(0, 1), (0, 2), (0, 3), (1, 2), (1, 3), (2, 3)]
+    blocks = []
+    for _ in range(n_rounds):
+        q = torch.eye(_ROTOR_BLOCK).expand(n_blocks, -1, -1).clone()
+        for (i, j) in planes:
+            ang = torch.rand(n_blocks, generator=rng) * (2 * math.pi)
+            c, sn = torch.cos(ang), torch.sin(ang)
+            g = torch.eye(_ROTOR_BLOCK).expand(n_blocks, -1, -1).clone()
+            g[:, i, i] = c
+            g[:, j, j] = c
+            g[:, i, j] = -sn
+            g[:, j, i] = sn
+            q = torch.bmm(g, q)
+        blocks.append(q.to(device=device, dtype=torch.float32))
+
+    # Stride permutation: interleaves coordinates so the next round's blocks see
+    # values from four different blocks of this round.
+    idx = torch.arange(d).view(_ROTOR_BLOCK, d // _ROTOR_BLOCK).t().reshape(-1)
+    perm = idx.to(device=device)
+    inv = torch.empty_like(perm)
+    inv[perm] = torch.arange(d, device=device)
+    return blocks, perm, inv
+
+
+def rotate_forward_rotor(x: torch.Tensor, params) -> torch.Tensor:
+    """Apply the rounds in order: block rotate, then shuffle."""
+    blocks, perm, _ = params
+    d = x.shape[-1]
+    orig = x.shape
+    y = x.reshape(-1, d)
+    for q in blocks:
+        y = torch.einsum("nbi,bij->nbj", y.view(-1, d // _ROTOR_BLOCK, _ROTOR_BLOCK), q)
+        y = y.reshape(-1, d)[:, perm]
+    return y.reshape(orig)
+
+
+def rotate_backward_rotor(y: torch.Tensor, params) -> torch.Tensor:
+    """Exact inverse: undo the shuffle, then the block rotation, in reverse."""
+    blocks, _, inv = params
+    d = y.shape[-1]
+    orig = y.shape
+    x = y.reshape(-1, d)
+    for q in reversed(blocks):
+        x = x[:, inv]
+        x = torch.einsum("nbj,bij->nbi", x.view(-1, d // _ROTOR_BLOCK, _ROTOR_BLOCK), q)
+        x = x.reshape(-1, d)
+    return x.reshape(orig)
+

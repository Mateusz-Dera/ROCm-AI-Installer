+def _resolve_kv_share(state, self_impl):
+    """Find k_norm / rotary_emb for this layer, or None if sharing cannot apply.
+
+    Cached on the state: the walk is over the whole model and the answer never
+    changes. Returns None for windowed layers (they have their own v_proj, so
+    there is nothing to share) and whenever the parent cannot be located.
+    """
+    cached = getattr(state, "_kv_share", "unset")
+    if cached != "unset":
+        return cached
+
+    share = None
+    if _sliding_of(self_impl) <= 0:
+        model = getattr(state, "_model_ref", None)
+        target = getattr(state, "layer_name", None)
+        if model is not None and target is not None:
+            for _, mod in model.named_modules():
+                attn = getattr(mod, "attn", None)
+                if attn is None or getattr(attn, "layer_name", None) != target:
+                    continue
+                k_norm = getattr(mod, "k_norm", None)
+                rot = getattr(mod, "rotary_emb", None)
+                if k_norm is not None and rot is not None:
+                    share = (k_norm, rot)
+                break
+
+    state._kv_share = share
+    return share
+

+def _k_from_v(share, v_block, start_pos):
+    """Rebuild keys from the raw projection: RMSNorm, then RoPE at their own
+    positions. v_block is [H, N, D]; positions run from start_pos."""
+    k_norm, rot = share
+    H, N, D = v_block.shape
+    flat = v_block.permute(1, 0, 2).reshape(N, H * D)
+    normed = k_norm(flat.view(-1, D).to(torch.float16)).view(N, H * D)
+    pos = torch.arange(start_pos, start_pos + N, device=v_block.device)
+    # rotary_emb rotates query and key together; a zero query is discarded.
+    # A shared, un-zeroed scratch buffer was tried here and measured no gain
+    # (the caching allocator already reuses same-shape blocks), so the plain
+    # allocation stays rather than a shared mutable buffer that relies on the
+    # kernel overwriting before reading.
+    _, k_rot = rot(pos, torch.zeros_like(normed), normed)
+    return k_rot.view(N, H, D).permute(1, 0, 2).to(v_block.dtype)
+

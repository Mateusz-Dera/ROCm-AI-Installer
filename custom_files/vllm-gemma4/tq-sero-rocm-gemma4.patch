+def _req_key(state, attn_metadata, r: int):
+    """Stable identity for request r: vLLM's own request id.
+
+    The batch index cannot be used - vLLM reorders requests between steps. The
+    first block of the block-table row cannot be used either, which is the trap
+    this walked into: under no_alloc these layers have *no* paged KV cache and
+    therefore no block table, so that version silently returned 0 for every
+    request and all sessions shared one store. It still scored 5/5 on needles,
+    because each session's own codes were in the merged history.
+
+    input_batch.req_ids is a plain list of strings - no device sync, unique for
+    the request's lifetime, and never recycled.
+    """
+    ids = _batch_req_ids(state)
+    if ids is not None and r < len(ids) and ids[r] is not None:
+        return ids[r]
+    # No identity available: fall back to one shared store rather than
+    # inventing keys that would split a single request's history.
+    return 0
+
+
+def _batch_req_ids(state):
+    """Request ids in batch order, or None.
+
+    In this vLLM the runner lives in  (not the
+    older ) and keeps no  attribute at all - the
+    batch is built per step inside  and parked on
+    . Reading the attribute that does not exist returned
+    None silently, which is how every request ended up sharing one store.
+
+    These are plain strings in the same order the attention metadata uses, so
+    no device sync and no reordering hazard.
+    """
+    runner = getattr(state, "_runner", None)
+    batch = getattr(runner, "_tq_batch", None) if runner is not None else None
+    ids = getattr(batch, "req_ids", None) if batch is not None else None
+    return ids if ids else None
+
+
+def _live_req_ids(state):
+    """Ids of every request the runner still considers active, or None.
+
+    Deliberately NOT the current step's batch - see module history: a request
+    waiting its turn under chunked prefill is absent from the batch but very
+    much alive, and evicting it discards its compressed history.
+    """
+    runner = getattr(state, "_runner", None)
+    reqs = getattr(runner, "req_states", None) if runner is not None else None
+    table = getattr(reqs, "req_id_to_index", None) if reqs is not None else None
+    if not table:
+        return None
+    return set(table.keys())
+
+
+def _context_len(attn_metadata, r: int, qlen: int) -> int:
+    """Tokens already behind request r, excluding the chunk being processed.
+
+    Zero means this is the request's first chunk, which is the only reliable
+    signal that a recycled block id belongs to a new sequence rather than to
+    the one that previously held it.
+    """
+    sl = getattr(attn_metadata, "seq_lens_cpu", None)
+    if sl is None:
+        sl = getattr(attn_metadata, "seq_lens", None)
+    if sl is None or r >= len(sl):
+        return -1
+    return int(sl[r]) - qlen
+
+
+def _state_for(state, attn_metadata, r: int, qlen: int = -1):
+    """(store, engine) for request r, created on first sight.
+
+    Keyed through the map even for a single request. Branching on num_reqs
+    instead looked cheaper but is wrong across a session: when one of two
+    requests finishes, num_reqs drops back to 1 and the survivor would be
+    handed the layer's own pair - a different store than the one holding its
+    history, which vanishes mid-generation.
+
+    The first request seen adopts the layer's own pair, so one long sequence
+    still allocates nothing extra and behaves exactly as before.
+
+    vLLM recycles block ids, so a key alone does not identify a sequence. A
+    request arriving with no context behind it is starting fresh; if a store
+    is already parked on its key it belongs to a finished request and must be
+    cleared, or the new sequence reads the old one's history.
+    """
+    per = getattr(state, "_per_req", None)
+    if per is None:
+        per = state._per_req = {}
+    key = _req_key(state, attn_metadata, r)
+
+    # Diagnostics: which keys were ever seen, and how often a reset fired.
+    seen = getattr(state, "_key_log", None)
+    if seen is None:
+        seen = state._key_log = {"keys": set(), "resets": 0}
+    seen["keys"].add(key)
+
+    # Request ids are unique, so a live key never belongs to a finished
+    # request and no reset is needed. What is needed is eviction: without it
+    # every completed request leaves its compressed history in VRAM forever.
+    if ids := _live_req_ids(state):
+        for stale in [k for k in per if k not in ids]:
+            st, eng = per.pop(stale)
+            st.reset()
+            eng.reset()
+            seen["resets"] += 1
+
+    # A request with nothing behind its current chunk is at token zero. For a
+    # brand-new request the key is simply absent; for a preempted one the key
+    # is present with a stale partial history that must go, or the restarted
+    # prefill stacks a second copy on top of it.
+    if (key in per and qlen >= 0
+            and _context_len(attn_metadata, r, qlen) == 0):
+        st, eng = per[key]
+        if eng.total_tokens > 0:
+            st.reset()
+            eng.reset()
+            seen["restarts"] = seen.get("restarts", 0) + 1
+
+    if key not in per:
+        per[key] = ((state.store, state.engine) if not per
+                    else _new_store_engine(state.config, template=state.store))
+
+    live = sum(st.num_tokens for st, _ in per.values())
+    seen["peak_tokens"] = max(seen.get("peak_tokens", 0), live)
+    seen["peak_stores"] = max(seen.get("peak_stores", 0), len(per))
+    if ids:
+        seen["peak_live"] = max(seen.get("peak_live", 0), len(ids))
+    return per[key]
+

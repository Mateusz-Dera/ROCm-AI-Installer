+/* Query-block size for the explicit (non-flash) attention path. The full
+ * [N_k, N_q, heads, batch] score matrix is materialized N_q queries at a time
+ * so its peak size is N_k*chunk instead of N_k*N_q. Tunable via
+ * TRELLIS_ATTN_QUERY_CHUNK; 0 disables chunking (original single-shot path). */
+static int64_t trellis_ggml_attention_query_chunk(void) {
+    const char * env = getenv("TRELLIS_ATTN_QUERY_CHUNK");
+    if (env != NULL && env[0] != '\0') {
+        char * end = NULL;
+        long long value = strtoll(env, &end, 10);
+        if (end != env && value >= 0) {
+            return (int64_t) value;
+        }
+    }
+    return 2048;
+}

     }
 
-    struct ggml_tensor * scores = ggml_mul_mat(ctx, k, q);
-    scores = ggml_scale(ctx, scores, scale);
-    scores = ggml_soft_max(ctx, scores);
+    /* Explicit QK^T softmax. The full [N_k, N_q, heads, batch] score matrix can
+     * exceed VRAM for large query counts (e.g. Pixal3D 1024_cascade shape flow
+     * needs ~12.7 GB at once on a 24 GB GPU). Chunk over query blocks: softmax
+     * runs over the key dim (ne[0]), so each query row is independent and the
+     * per-block results are numerically identical to the unchunked path. Peak
+     * score memory drops from N_k*N_q to N_k*chunk. */
     struct ggml_tensor * v_t = ggml_permute(ctx, v, 1, 0, 2, 3);
     v_t = ggml_cont_4d(ctx, v_t, v->ne[1], v->ne[0], v->ne[2], v->ne[3]);
-    return ggml_mul_mat(ctx, v_t, scores);
+
+    const int64_t n_q = q->ne[1];
+    const int64_t q_chunk = trellis_ggml_attention_query_chunk();
+    if (q_chunk <= 0 || q_chunk >= n_q) {
+        struct ggml_tensor * scores = ggml_mul_mat(ctx, k, q);
+        scores = ggml_scale(ctx, scores, scale);
+        scores = ggml_soft_max(ctx, scores);
+        return ggml_mul_mat(ctx, v_t, scores);
+    }
+
+    struct ggml_tensor * out = NULL;
+    for (int64_t qo = 0; qo < n_q; qo += q_chunk) {
+        const int64_t blk = (qo + q_chunk <= n_q) ? q_chunk : (n_q - qo);
+        struct ggml_tensor * q_blk = ggml_view_4d(
+            ctx, q, q->ne[0], blk, q->ne[2], q->ne[3],
+            q->nb[1], q->nb[2], q->nb[3], (size_t) qo * q->nb[1]);
+        struct ggml_tensor * scores = ggml_mul_mat(ctx, k, q_blk);
+        scores = ggml_scale(ctx, scores, scale);
+        scores = ggml_soft_max(ctx, scores);
+        struct ggml_tensor * o = ggml_mul_mat(ctx, v_t, scores);
+        out = (out == NULL) ? o : ggml_concat(ctx, out, o, 1);
+    }
+    return out;
 }
 
